; Collision viewer pixel shader. Each vertex carries its own window depth in
; UV.x (the atlas is not sampled), the scene depth buffer is bound as texture
; 1 and sampled at the fragment's screen position, and the fragment is killed
; when it lies behind the scene:
;
;   (fragmentDepth - sceneDepth) * Params.x + Params.y > 0  ->  kill
;
; Params.x is +1 for a depth buffer that grows with distance and -1 for a
; reversed one; Params.y is the negated bias in window-depth units.

; $MODE = "UniformRegister"

; $NUM_SPI_PS_INPUT_CNTL = 3
; Frag_UV R0 (x = window depth)
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
; Frag_Color R1
; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
; Frag_Screen R2 (0..1 across the target, y down)
; $SPI_PS_INPUT_CNTL[2].SEMANTIC = 2
; $SPI_PS_INPUT_CNTL[2].DEFAULT_VAL = 1

; C0
; $UNIFORM_VARS[0].name = "Params"
; $UNIFORM_VARS[0].type = "vec4"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].block = -1
; $UNIFORM_VARS[0].offset = 0

; $SAMPLER_VARS[0].name = "Texture"
; $SAMPLER_VARS[0].type = "SAMPLER2D"
; $SAMPLER_VARS[0].location = 0
; $SAMPLER_VARS[1].name = "Depth"
; $SAMPLER_VARS[1].type = "SAMPLER2D"
; $SAMPLER_VARS[1].location = 1

; Note: R1 is swapped for endianness

00 TEX: ADDR(48) CNT(1) VALID_PIX
    0  SAMPLE R3, R2.xy0x, t1, s1
01 ALU: ADDR(32) CNT(7)
    1  x: ADD    R3.x, R0.x, -R3.x
    2  x: MULADD R3.x, R3.x, C0.x, C0.y
    3  x: KILLGT ____, R3.x, 0.0f
    4  x: MOV    R0.x, R1.w
       y: MOV    R0.y, R1.z
       z: MOV    R0.z, R1.y
       w: MOV    R0.w, R1.x
02 EXP_DONE: PIX0, R0
END_OF_PROGRAM
